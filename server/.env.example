# Server port (default: 8080)
PORT=8080

# Redis connection URL (default: redis://localhost:6379)
# For Redis with auth: redis://:password@host:6379
# IMPORTANT: Requires Redis with JSON module — use Redis Stack, Redis 8.0+, or Redis Cloud with JSON enabled
REDIS_URL=redis://localhost:6379

# Log verbosity: error | warn | info | debug (default: info)
LOG_LEVEL=info
